{
  "name": "@cujuju/electron-updates",
  "version": "0.1.0",
  "description": "Signed stable and nightly updates for Electron apps from GitHub releases, one update path on Windows, macOS and Linux.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "cujuju-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./node": {
      "cujuju-source": "./src/node/index.ts",
      "types": "./dist/node/index.d.ts",
      "import": "./dist/node.js"
    }
  },
  "files": [
    "src",
    "dist",
    "!src/__tests__"
  ],
  "sideEffects": false,
  "license": "MIT",
  "author": "Cujuju",
  "repository": {
    "type": "git",
    "url": "https://github.com/Cujuju/solidjs-toolkit.git",
    "directory": "packages/electron-updates"
  },
  "homepage": "https://github.com/Cujuju/solidjs-toolkit/tree/main/packages/electron-updates",
  "bugs": "https://github.com/Cujuju/solidjs-toolkit/issues",
  "keywords": [
    "electron",
    "auto-update",
    "nightly",
    "ed25519"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "vite build",
    "prepublishOnly": "vite build"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "vitest": "^4.1.12"
  },
  "publishConfig": {
    "access": "public"
  }
}
