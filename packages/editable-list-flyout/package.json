    "prepublishOnly": "vite build"
  },
  "devDependencies": {
    "@cujuju/solidjs-anchored-popover": "workspace:^",
    "@cujuju/solidjs-editable-list-row": "workspace:^",
    "@cujuju/solidjs-hooks": "workspace:^",
    "@solidjs/testing-library": "^0.8.0",
    "@testing-library/jest-dom": "^6.9.1",
    "jsdom": "^24.0.0",
    "vite-plugin-solid": "^2.11.12",
    "vitest": "^3.2.4"
