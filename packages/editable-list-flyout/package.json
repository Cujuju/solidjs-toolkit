    ".": {
      "types": "./dist/index.d.ts",
      "solid": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./src/styles.css"
  },
  "files": [
    "src",
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "license": "MIT",
  "author": "Cujuju",
  "repository": {
    "type": "git",
    "url": "https://github.com/Cujuju/solidjs-toolkit.git",
    "directory": "packages/editable-list-flyout"
  },
  "homepage": "https://github.com/Cujuju/solidjs-toolkit/tree/main/packages/editable-list-flyout",
  "bugs": "https://github.com/Cujuju/solidjs-toolkit/issues",
  "keywords": [
    "solidjs",
    "flyout",
    "popover",
    "select",
    "editable-list",
    "inline-add"
  ],
  "peerDependencies": {
    "@cujuju/solidjs-anchored-popover": "workspace:^",
    "@cujuju/solidjs-editable-list-row": "workspace:^",
    "@cujuju/solidjs-hooks": "workspace:^",
    "solid-js": ">=1.7.0"
