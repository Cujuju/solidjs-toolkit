{
  "name": "@cujuju/solidjs-editable-list-row",
  "version": "0.1.0",
  "description": "Editable list row primitive for SolidJS — inline rename, delete-with-confirm, selection variants, drag-reorder pass-through, leading icon/control slot.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "solid": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./src/styles.css"
  },
  "files": [
    "src",
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "license": "MIT",
  "author": "Cujuju",
  "repository": {
    "type": "git",
    "url": "https://github.com/Cujuju/solidjs-toolkit.git",
    "directory": "packages/editable-list-row"
  },
  "homepage": "https://github.com/Cujuju/solidjs-toolkit/tree/main/packages/editable-list-row",
  "bugs": "https://github.com/Cujuju/solidjs-toolkit/issues",
  "keywords": [
    "solidjs",
    "list-row",
    "editable",
    "rename",
    "delete",
    "drag-reorder"
  ],
  "peerDependencies": {
    "@cujuju/solidjs-hooks": "^2.0.0",
    "solid-js": ">=1.7.0"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "vite build",
    "prepublishOnly": "vite build"
  },
  "devDependencies": {
    "@cujuju/solidjs-hooks": "workspace:*",
    "@solidjs/testing-library": "^0.8.0",
    "@testing-library/jest-dom": "^6.9.1",
    "jsdom": "^24.0.0",
    "vite-plugin-solid": "^2.11.12",
    "vitest": "^3.2.4"
  },
  "publishConfig": {
    "access": "public"
  }
}
