{
  "name": "playground",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Live dev harness for the @cujuju/solidjs-* packages. Consumes them from SOURCE via the workspace, so edits hot-reload with no build, no publish, and no linking into a consuming app.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@cujuju/solidjs-anchored-popover": "workspace:*",
    "@cujuju/solidjs-chip-flyout": "workspace:*",
    "@cujuju/solidjs-collapsible": "workspace:*",
    "@cujuju/solidjs-context-menu": "workspace:*",
    "@cujuju/solidjs-editable-list-flyout": "workspace:*",
    "@cujuju/solidjs-editable-list-row": "workspace:*",
    "@cujuju/solidjs-glass": "workspace:*",
    "@cujuju/solidjs-glass-menu": "workspace:*",
    "@cujuju/solidjs-hold-action": "workspace:*",
    "@cujuju/solidjs-hooks": "workspace:*",
    "@cujuju/solidjs-kv-tooltip": "workspace:*",
    "@cujuju/solidjs-pill-date-picker": "workspace:*",
    "@cujuju/solidjs-pill-number-picker": "workspace:*",
    "@cujuju/solidjs-pill-toggle": "workspace:*",
    "@cujuju/solidjs-seg-buttons": "workspace:*",
    "@cujuju/solidjs-select-flyout": "workspace:*",
    "@cujuju/solidjs-tri-state-chip": "workspace:*",
    "solid-js": "^1.9.5"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "jsdom": "^24.0.0",
    "vite": "^5.4.0",
    "vite-plugin-solid": "^2.11.12",
    "vitest": "^3.2.4"
  }
}
